@startuml
title Mr. Patitas — Diagrama de componentes y despliegue (Entrega 2 de 3)
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle

actor "Desarrollador" as Dev
actor "Profesora / Usuario" as User

package "Equipo de desarrollo (solo en el PC del desarrollador)" {
  folder "frontend/" as Frontend {
    component "React + TypeScript\nComponentes UI (src/components/)" as ReactUI
    component "Datos de prueba\ndemoProducts.ts / categories.ts" as DemoData
    component "Estilos centralizados\nTailwind CSS (src/index.css)" as Styles
    component "Ilustraciones SVG\n(src/assets/images/)" as SVG
  }
  component "Vite\nservidor de desarrollo y build" as Vite
  component "vite-plugin-singlefile\n(incrusta recursos en un HTML)" as SingleFile
}

package "Paquete de distribución: entrega/" {
  artifact "iniciar_mr_patitas.bat\nLanzador Windows" as BAT
  artifact "MrPatitas.html\nHTML compilado portable" as HTML
  artifact "LEEME.txt\nInstrucciones" as Readme
}

node "PC Windows de la profesora" as PC {
  component "Navegador web\n(Edge / Chrome / Firefox)" as Browser
  component "Aplicación Mr. Patitas\nReact compilado + CSS + JS" as App
  component "Datos locales de prueba\nincorporados al bundle" as DataRuntime
  component "SVG / recursos visuales\nincrustados" as AssetsRuntime
}

Dev --> Frontend : modifica código fuente
ReactUI --> DemoData : consulta productos y categorías
ReactUI --> Styles : utiliza estilos
ReactUI --> SVG : muestra ilustraciones
Frontend --> Vite : fuente de compilación
Vite --> SingleFile : genera build portable
SingleFile --> HTML : produce archivo único
Dev --> BAT : prepara y prueba la entrega

User --> BAT : doble clic
BAT --> HTML : abre mediante ruta relativa\n(%~dp0MrPatitas.html)
HTML --> Browser : archivo local (file://)
Browser --> App : ejecuta JavaScript compilado
App --> DataRuntime : lee catálogo de prueba
App --> AssetsRuntime : muestra recursos integrados

note bottom of Frontend
  Node.js y npm se utilizan únicamente
  para desarrollar, instalar dependencias
  y compilar en el PC del desarrollador.
end note

note bottom of PC
  En el PC de la profesora no se requiere:
  Node.js, npm, VS Code, backend,
  base de datos, servidor local ni Internet.
end note

note right of HTML
  El HTML final integra dentro del archivo:
  - JavaScript compilado
  - CSS compilado
  - datos de prueba
  - ilustraciones SVG
  No depende de CDN, fetch() ni rutas externas.
end note
@enduml
